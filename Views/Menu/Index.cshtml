@{
    ViewData["Title"] = "Our Menu";

    var foods = new[]
    {
        new { Id = 1, Name = "Margherita Pizza", Category = "Pizza",
            Price = 199, Description = "Classic cheese and tomato pizza.",
            Image = "https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&fit=crop&w=700&q=80" },

        new { Id = 2, Name = "Veg Burger", Category = "Burger",
            Price = 99, Description = "Fresh vegetables and a soft bun.",
            Image = "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=700&q=80" },

        new { Id = 3, Name = "Cold Coffee", Category = "Drinks",
            Price = 89, Description = "Chilled and creamy coffee.",
            Image = "https://images.unsplash.com/photo-1572490122747-3968b75cc699?auto=format&fit=crop&w=700&q=80" },

        new { Id = 4, Name = "Chocolate Brownie", Category = "Desserts",
            Price = 79, Description = "Rich chocolate dessert.",
            Image = "https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=700&q=80" },

        new { Id = 5, Name = "Farmhouse Pizza", Category = "Pizza",
            Price = 249, Description = "A delicious veggie-loaded pizza.",
            Image = "https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=700&q=80" },

        new { Id = 6, Name = "Classic Cheeseburger", Category = "Burger",
            Price = 149, Description = "A hearty burger with melted cheese.",
            Image = "https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=700&q=80" },

        new { Id = 7, Name = "Fresh Lemon Drink", Category = "Drinks",
            Price = 59, Description = "A refreshing citrus drink.",
            Image = "https://images.unsplash.com/photo-1555949366-819808d99159?auto=format&fit=crop&w=700&q=80" },

        new { Id = 8, Name = "Chocolate Cake", Category = "Desserts",
            Price = 129, Description = "Soft cake with rich chocolate.",
            Image = "https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=700&q=80" }
    };
}

<section class="page-banner">
    <div class="container">
        <h1>Our Delicious Menu</h1>
        <p class="text-muted mb-0">
            Explore your favourites and order something delicious.
        </p>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <input type="search" id="menuSearch"
                       class="form-control"
                       placeholder="Search pizza, burger, coffee..." />
            </div>

            <div class="col-md-5">
                <select id="categoryFilter" class="form-select">
                    <option value="all">All Categories</option>
                    <option value="Pizza">Pizza</option>
                    <option value="Burger">Burgers</option>
                    <option value="Drinks">Drinks</option>
                    <option value="Desserts">Desserts</option>
                </select>
            </div>
        </div>

        <div class="row g-4" id="menuGrid">
            @foreach (var food in foods)
            {
                <div class="col-sm-6 col-lg-3 menu-item"
                     data-name="@food.Name.ToLowerInvariant()"
                     data-category="@food.Category">
                    <div class="food-card">
                        <img src="@food.Image"
                             alt="@food.Name"
                             class="food-image" />

                        <div class="food-card-body">
                            <span class="badge text-bg-light mb-2">
                                @food.Category
                            </span>

                            <h5>@food.Name</h5>
                            <p class="food-description">
                                @food.Description
                            </p>

                            <div class="d-flex justify-content-between
                                            align-items-center gap-2">
                                <span class="food-price">
                                    ₹@food.Price
                                </span>

                                <button type="button"
                                        class="btn btn-brand btn-sm"
                                        data-add-cart
                                        data-id="@food.Id"
                                        data-name="@food.Name"
                                        data-price="@food.Price"
                                        data-image="@food.Image">
                                    + Add
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="noMenuResults" class="empty-state d-none">
            <div class="empty-icon">🔎</div>
            <h4>No food items found</h4>
            <p class="text-muted">Try another search or category.</p>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const menuSearch = document.getElementById("menuSearch");
        const categoryFilter = document.getElementById("categoryFilter");
        const menuItems = document.querySelectorAll(".menu-item");
        const noResults = document.getElementById("noMenuResults");

        function filterMenu() {
            const search = menuSearch.value.toLowerCase().trim();
            const category = categoryFilter.value;
            let visible = 0;

            menuItems.forEach(item => {
                const matchesSearch = item.dataset.name.includes(search);
                const matchesCategory =
                    category === "all" ||
                    item.dataset.category === category;

                const show = matchesSearch && matchesCategory;
                item.classList.toggle("d-none", !show);

                if (show) visible++;
            });

            noResults.classList.toggle("d-none", visible !== 0);
        }

        menuSearch.addEventListener("input", filterMenu);
        categoryFilter.addEventListener("change", filterMenu);

        const requestedCategory =
            new URLSearchParams(window.location.search).get("category");

        if (requestedCategory &&
            [...categoryFilter.options].some(
                option => option.value === requestedCategory
            )) {
            categoryFilter.value = requestedCategory;
            filterMenu();
        }
    </script>
}

