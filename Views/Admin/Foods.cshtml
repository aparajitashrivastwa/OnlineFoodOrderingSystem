@{
    ViewData["Title"] = "Manage Food";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold">Manage Food Items</h1>
            <p class="text-muted mb-0">Sample admin interface.</p>
        </div>

        <button class="btn btn-brand" type="button"
                onclick="alert('Connect the Add Food form to the backend next.')">
            + Add Food
        </button>
    </div>

    <div class="table-responsive border rounded-4 p-3">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Food Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Margherita Pizza</td>
                    <td>Pizza</td>
                    <td>₹199</td>
                    <td><span class="badge text-bg-success">Available</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                type="button"
                                onclick="alert('Edit form will be connected later.')">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                type="button"
                                onclick="alert('Delete will be connected later.')">
                            Delete
                        </button>
                    </td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Veg Burger</td>
                    <td>Burger</td>
                    <td>₹99</td>
                    <td><span class="badge text-bg-success">Available</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                type="button"
                                onclick="alert('Edit form will be connected later.')">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                type="button"
                                onclick="alert('Delete will be connected later.')">
                            Delete
                        </button>
                    </td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Cold Coffee</td>
                    <td>Drinks</td>
                    <td>₹89</td>
                    <td><span class="badge text-bg-success">Available</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                type="button"
                                onclick="alert('Edit form will be connected later.')">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                type="button"
                                onclick="alert('Delete will be connected later.')">
                            Delete
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <a asp-controller="Admin" asp-action="Index"
       class="btn btn-outline-brand mt-4">← Back to Dashboard</a>
</div>
