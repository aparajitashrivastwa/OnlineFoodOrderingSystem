@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold">Admin Dashboard</h1>
        <p class="text-muted">
            Overview of your food ordering system.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <p class="text-muted mb-1">Total Orders</p>
                <div class="stat-number">128</div>
                <small class="text-muted">Demo data</small>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <p class="text-muted mb-1">Total Revenue</p>
                <div class="stat-number">₹24,850</div>
                <small class="text-muted">Demo data</small>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <p class="text-muted mb-1">Food Items</p>
                <div class="stat-number">24</div>
                <small class="text-muted">Demo data</small>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <p class="text-muted mb-1">Customers</p>
                <div class="stat-number">86</div>
                <small class="text-muted">Demo data</small>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-lg-3">
            <div class="admin-sidebar">
                <h5 class="text-white mb-4">Admin Panel</h5>
                <a class="active" asp-controller="Admin" asp-action="Index">
                    Dashboard
                </a>
                <a asp-controller="Admin" asp-action="Foods">
                    Manage Food
                </a>
                <a asp-controller="Admin" asp-action="Orders">
                    Manage Orders
                </a>
                <a asp-controller="Admin" asp-action="Reports">
                    Sales Reports
                </a>
                <a asp-controller="Home" asp-action="Index">
                    View Website
                </a>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="border rounded-4 p-4">
                <h4 class="fw-bold mb-3">Welcome, Administrator!</h4>
                <p class="text-muted">
                    Use the admin panel to manage food items, review
                    customer orders and monitor sales.
                </p>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Admin" asp-action="Foods"
                       class="btn btn-brand">Manage Food</a>
                    <a asp-controller="Admin" asp-action="Orders"
                       class="btn btn-outline-brand">View Orders</a>
                    <a asp-controller="Admin" asp-action="Reports"
                       class="btn btn-outline-brand">Sales Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>
