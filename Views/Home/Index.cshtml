@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="badge rounded-pill text-bg-warning mb-3">
                    Fresh & Delicious
                </span>

                <h1>Good Food.<br /><span>Good Mood.</span></h1>

                <p class="my-4">
                    Discover your favourite meals and enjoy delicious food
                    delivered right to your doorstep.
                </p>

                <a asp-controller="Menu" asp-action="Index"
                   class="btn btn-brand btn-lg">
                    Explore Our Menu →
                </a>

                <div class="d-flex gap-4 mt-4">
                    <div>
                        <h4 class="fw-bold mb-0">Fresh</h4>
                        <small class="text-muted">Ingredients</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Easy</h4>
                        <small class="text-muted">Ordering</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Fast</h4>
                        <small class="text-muted">Service</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <img class="hero-image"
                     src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&amp;fit=crop&amp;w=1000&amp;q=85"
                     alt="Freshly prepared pizza" />
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="text-center">
            <h2 class="section-title">Explore Categories</h2>
            <p class="section-subtitle">
                Something delicious for every craving.
            </p>
        </div>

        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a class="category-card" href="/Menu?category=Pizza">
                    <span class="category-icon">🍕</span>
                    <strong>Pizza</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a class="category-card" href="/Menu?category=Burger">
                    <span class="category-icon">🍔</span>
                    <strong>Burgers</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a class="category-card" href="/Menu?category=Drinks">
                    <span class="category-icon">🥤</span>
                    <strong>Drinks</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a class="category-card" href="/Menu?category=Desserts">
                    <span class="category-icon">🍰</span>
                    <strong>Desserts</strong>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between
                    align-items-center mb-4">
            <div>
                <h2 class="section-title">Popular Dishes</h2>
                <p class="section-subtitle mb-0">
                    Our favourites, made for you.
                </p>
            </div>

            <a asp-controller="Menu" asp-action="Index"
               class="btn btn-outline-brand">
                View All
            </a>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-lg-4">
                <div class="food-card">
                    <img class="food-image"
                         src="https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&amp;fit=crop&amp;w=700&amp;q=80"
                         alt="Margherita pizza" />
                    <div class="food-card-body">
                        <h5>Margherita Pizza</h5>
                        <p class="food-description">
                            Classic pizza with cheese and tomato.
                        </p>
                        <div class="d-flex justify-content-between
                                    align-items-center">
                            <span class="food-price">₹199</span>
                            <a href="/Menu" class="btn btn-brand">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="food-card">
                    <img class="food-image"
                         src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&amp;fit=crop&amp;w=700&amp;q=80"
                         alt="Veg burger" />
                    <div class="food-card-body">
                        <h5>Veg Burger</h5>
                        <p class="food-description">
                            A satisfying burger with fresh vegetables.
                        </p>
                        <div class="d-flex justify-content-between
                                    align-items-center">
                            <span class="food-price">₹99</span>
                            <a href="/Menu" class="btn btn-brand">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="food-card">
                    <img class="food-image"
                         src="https://images.unsplash.com/photo-1572490122747-3968b75cc699?auto=format&amp;fit=crop&amp;w=700&amp;q=80"
                         alt="Cold coffee" />
                    <div class="food-card-body">
                        <h5>Cold Coffee</h5>
                        <p class="food-description">
                            A cool, creamy drink for any time of day.
                        </p>
                        <div class="d-flex justify-content-between
                                    align-items-center">
                            <span class="food-price">₹89</span>
                            <a href="/Menu" class="btn btn-brand">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container text-center">
        <h2 class="section-title">Hungry? Let's Fix That!</h2>
        <p class="section-subtitle">
            Your next favourite meal is just a click away.
        </p>
        <a asp-controller="Menu" asp-action="Index"
           class="btn btn-brand btn-lg">
            Order Your Food
        </a>
    </div>
</section>

