@{
    ViewData["Title"] = "My Cart";
}

<section class="page-banner">
    <div class="container">
        <h1>My Shopping Cart</h1>
        <p class="text-muted mb-0">
            Review your items before checking out.
        </p>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                <div id="cartItems"></div>
            </div>

            <div class="col-lg-4">
                <div class="summary-card">
                    <h4 class="fw-bold mb-4">Order Summary</h4>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span id="cartSubtotal">₹0.00</span>
                    </div>

                    <div class="summary-row">
                        <span>Delivery</span>
                        <span class="text-success">Free</span>
                    </div>

                    <hr />

                    <div class="summary-row fw-bold fs-5">
                        <span>Total</span>
                        <span class="text-brand" id="cartTotal">₹0.00</span>
                    </div>

                    <a href="/Checkout"
                       class="btn btn-brand w-100 mt-3">
                        Proceed to Checkout →
                    </a>

                    <a href="/Menu"
                       class="btn btn-outline-brand w-100 mt-2">
                        Continue Shopping
                    </a>

                    <p class="text-muted small mt-3 mb-0">
                        Prices shown are demo prices until connected
                        to the server database.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
